<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="career-snowflakes"
        Arguments=""
        InstallLocation="C:\Program Files\Career Snowflakes">
    </Installer>
    <PackageInformation
        PackageName="Career Snowflakes"
        PackageDisplayName="Career Snowflakes"
        PublisherName="CN=Career Snowflakes"
        PublisherDisplayName="Career Snowflakes"
        Version="0.1.0.0"
        PackageDescription="A personal career development map">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.careersnowflakes.desktop"
                Description="A personal career development map"
                DisplayName="Career Snowflakes"
                ExecutableName="career-snowflakes"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Career Snowflakes</DisplayName>
            <PublisherDisplayName>Career Snowflakes</PublisherDisplayName>
            <Description>A personal career development map</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="career-snowflakes.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
