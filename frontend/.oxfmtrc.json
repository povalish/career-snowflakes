{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**", "react-*", "react-*/**"]
      },
      {
        "groupName": "project",
        "elementNamePattern": ["@/**"]
      },
      {
        "groupName": "relative",
        "elementNamePattern": [".", "..", "./**", "../**"]
      }
    ],
    "groups": [
      "react",
      ["builtin", "external", "subpath", "internal", "side_effect_style", "side_effect", "style"],
      "project",
      "relative",
      "unknown"
    ],
    "newlinesBetween": true
  },
  "ignorePatterns": ["_legacy/**", "bindings/**", "dist/**", "coverage/**", "pnpm-lock.yaml"]
}
